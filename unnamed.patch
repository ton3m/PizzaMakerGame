@@ -0,0 +1,26 @@
+using PizzaMaker.Code.Services.GameFinishDetector;
+using PizzaMaker.Code.Utils.Reactive;
+
+namespace PizzaMaker.Code.Entry
+{
+    public class CharacterDeathObserver : IUpdateable
+    {
+        private ReactiveVariable<bool> _isDead;
+        private readonly ICondition _condition;
+
+        public CharacterDeathObserver(ICondition condition)
+        {
+            _condition = condition;
+        }
+
+        public IReadOnlyVariable<bool> IsDead => _isDead;
+
+        public void Update()
+        {
+            if (IsDead.Value == true) return;
+
+            if (_condition.IsSatisfied())
+                _isDead.Value = true;
+        }
+    }
+}
