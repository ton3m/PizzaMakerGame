+using System;
+using PizzaMaker.Code.Core.Collision;
+using PizzaMaker.Code.Core.Tags;
+using PizzaMaker.Code.Services.GameFinishDetector;
+using PizzaMaker.Code.Utils.Reactive;
+using UnityEngine;
+
+namespace PizzaMaker.Code.Core
+{
+    public class FinishLinePassedObserver : IDisposable 
+    {
+        private ReactiveVariable<bool> _isPassed;
+        private readonly ICollisionDetector _collisionDetector;
+
+        public FinishLinePassedObserver(ICollisionDetector collisionDetector)
+        {
+            _collisionDetector = collisionDetector;
+            _collisionDetector.Enter += OnCollisionEnter;
+        }
+
+        public void Dispose() => 
+            _collisionDetector.Enter -= OnCollisionEnter;
+
+        public IReadOnlyVariable<bool> IsPassed => _isPassed;
+        private void OnCollisionEnter(Collider obj)
+        {
+            if (obj.gameObject.GetComponent<FinishLine>() != null)
+            {
+                _isPassed.Value = true;
+            }
+        }
+    }
+}
