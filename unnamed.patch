+using System;
+using UnityEngine;
+
+namespace PizzaMaker.Code.Core.Collision
+{
+    public class CollisionDetector : MonoBehaviour, ICollisionDetector
+    {
+        public event Action<Collider> Enter;
+        public event Action<Collider> Exit;
+
+        private void OnCollisionEnter(UnityEngine.Collision other) => Enter?.Invoke(other.collider);
+        private void OnCollisionExit(UnityEngine.Collision other) => Exit?.Invoke(other.collider);
+        
+        private void OnTriggerEnter(Collider other) => Enter?.Invoke(other);
+        private void OnTriggerExit(Collider other) => Exit?.Invoke(other);
+    }
+}
