+using System;
+using PizzaMaker.Code.Core;
+using PizzaMaker.Code.Core.Collision;
+using UnityEngine;
+
+namespace PizzaMaker.Code.Entry
+{
+    public class CharacterInstaller : MonoBehaviour
+    {
+        [SerializeField] private PathFollower _pathFollower;
+        [SerializeField] private SideMovement _sideMovement;
+        [SerializeField] private CollisionDetector _collisionDetector;
+        
+        private IHealth _health;
+        private ICharacterMovement _characterMovement;
+        
+        public CharacterInstaller Init(IHealth health)
+        {
+            _health = health;
+            _characterMovement = new CharacterMovement(_pathFollower, _sideMovement);
+        }
+        
+        public IHealth Health => _health;
+        public ICharacterMovement CharacterMovement => _characterMovement;
+        public CollisionDetector CollisionDetector => _collisionDetector;
+
+        public void DisableMovement()
+        {
+            _sideMovement.enabled = false;
+            _pathFollower.enabled = false;
+        }
+
+        public void EnableMovement()
+        {
+            _sideMovement.enabled = true;
+            _pathFollower.enabled = true;
+        }
+    }
+}
