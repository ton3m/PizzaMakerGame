+using System;
+using PizzaMaker.Code.Services.Scene;
+
+namespace PizzaMaker.Code.Configs
+{
+    public class GameConfig 
+    {
+        public SceneId LastLevelId { get; private set; } = SceneId.Level1;
+
+        public void SetLastLevel(int index)
+        {
+            int levelSceneId = (int)SceneId.Level1 + index;
+
+            if (Enum.IsDefined(typeof(SceneId), levelSceneId) == false)
+                throw new ArgumentException($"Provided scene {levelSceneId} is not a level");
+
+            LastLevelId = (SceneId)levelSceneId;
+        }
+    }
+}
